---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import WorkRows from '../../components/WorkRows.astro';
import { allWork } from '../../lib/work';

const work = await allWork();
const current = work.filter((w) => w.data.era === 'current');
const earlier = work.filter((w) => w.data.era === 'earlier');
---
<Base title="Work" current="work" description="Case studies in building research and design functions, measuring them, and changing how they work with AI.">
  <Hero
    eyebrow="Work"
    title="Case studies"
    emoji="🗂️"
    emojiLabel="folder"
    tagline="Organizations, operating systems, strategy and measurement. Screens show up only as evidence."
    horse="Before, what I did, what changed, what I'd redo. Every time."
  />
  <div class="cols" style="grid-template-columns: 1fr;">
    <section class="card panel" aria-labelledby="now-h">
      <div class="panel-head">
        <h2 id="now-h"><button class="emo" type="button" data-note="1" aria-label="Play a sound">🌱</button> Recent</h2>
        <span class="mono-label">Optro, 2023 to now. Design and strategy first</span>
      </div>
      <WorkRows items={current} />
    </section>
    <section class="card panel" aria-labelledby="earlier-h">
      <div class="panel-head">
        <h2 id="earlier-h"><button class="emo" type="button" data-note="6" aria-label="Play a sound">🌳</button> Earlier</h2>
        <span class="mono-label">GitLab and Workiva</span>
      </div>
      <p class="note"><span class="dot" aria-hidden="true"></span><span>Shorter pieces. Most of what I do now started here.</span></p>
      <WorkRows items={earlier} />
    </section>
  </div>
</Base>
