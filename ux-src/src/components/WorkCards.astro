---
import { slugOf, type Work } from '../lib/work';
interface Props { items: Work[]; size?: 'large' | 'small' }
const { items, size = 'large' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class:list={['cards', size]}>
  {items.map((w) => (
    <li>
      <a class="wcard" href={`${base}/work/${slugOf(w)}/`}>
        <span class="top">
          <span class="emoji" aria-hidden="true">{w.data.emoji}</span>
          {size === 'large'
            ? <span class="pilltag">{w.data.theme}</span>
            : <span class="company">{w.data.place}</span>}
        </span>
        <span class="title">{w.data.card}</span>
        <span class="hook">{w.data.hook}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; }
  .cards.large { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; }
  .cards.small { grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px; }
  .cards li { display: flex; }
  .wcard {
    flex: 1; display: flex; flex-direction: column; gap: 12px;
    background: var(--card); color: var(--ink); text-decoration: none;
    border-radius: 16px; padding: 28px; box-shadow: 0 16px 40px rgb(15 42 59 / 0.16);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .small .wcard { gap: 10px; border-radius: 14px; padding: 22px; box-shadow: 0 12px 30px rgb(15 42 59 / 0.14); }
  .wcard:hover { transform: translateY(-3px); box-shadow: 0 22px 48px rgb(15 42 59 / 0.24); }
  .wcard:hover .title { text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .wcard:focus-visible { outline: 3px solid var(--lime); outline-offset: 3px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .emoji { font-size: 36px; line-height: 1; }
  .small .emoji { font-size: 28px; }
  .pilltag {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: #3a4a56;
    border: 1px solid #cfd6dc; border-radius: 999px; padding: 4px 10px; white-space: nowrap;
  }
  .company { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #4a5a66; }
  .title { font-family: var(--font-head); font-weight: 700; font-size: 24px; line-height: 1.2; }
  .small .title { font-size: 19px; line-height: 1.25; }
  .hook { font-size: 16px; line-height: 1.55; color: var(--ink-2); }
  .small .hook { font-size: 14px; line-height: 1.5; }
  @media (prefers-reduced-motion: reduce) {
    .wcard { transition: none; }
    .wcard:hover { transform: none; }
  }
</style>
