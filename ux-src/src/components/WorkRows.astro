---
import { slugOf, type Work } from '../lib/work';
interface Props { items: Work[]; numbered?: boolean }
const { items, numbered = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ol class="rows">
  {items.map((w, i) => (
    <li>
      <span class="when">{w.data.place ?? (numbered ? `Case 0${i + 1}` : '')}</span>
      <div>
        <span class="what">
          <span aria-hidden="true">{w.data.emoji} </span><a href={`${base}/work/${slugOf(w)}/`}>{w.data.title}</a>
          <span class="chip">{w.data.theme}</span>
        </span>
        <p class="why">{w.data.summary}</p>
      </div>
    </li>
  ))}
</ol>
